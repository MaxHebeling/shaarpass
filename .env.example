# ─── ShaarPass · variables de entorno (esquema) ─────────────────────────────
# Copia a .env.local y rellena. NUNCA comitees .env.local ni secretos reales.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SOLO servidor (bypassa RLS). Nunca al cliente.
NEXT_PUBLIC_APP_URL=https://www.shaarpass.io

# Stripe (Connect · modo live)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...       # del endpoint /api/webhooks/stripe

# Comisiones / procesamiento (opcionales; hay defaults en el código)
PLATFORM_FEE_PERCENT=2
PLATFORM_FEE_FIXED_CENTS=50
# STRIPE_PROCESSING_PERCENT= / STRIPE_PROCESSING_FIXED=  (override por moneda)

# Crons (Vercel Cron manda Authorization: Bearer $CRON_SECRET). OBLIGATORIO.
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=ShaarPass <tickets@shaarpass.io>
RESEND_WEBHOOK_SECRET=whsec_...       # del endpoint /api/webhooks/resend (Svix)

# IA
ANTHROPIC_API_KEY=sk-ant-...          # análisis de recinto + generador por prompt
# ANTHROPIC_MODEL=claude-sonnet-4-6
REPLICATE_API_TOKEN=r8_...            # render fotorrealista
# REPLICATE_MODEL=black-forest-labs/flux-schnell
# GEMINI_API_KEY=                     # alternativa de render (no usada por defecto)

# Cola virtual en el edge + rate limiting (opcional; sin esto usa Postgres)
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN= / QUEUE_SECRET=

# Firma de los enlaces de baja de los correos. Sin esto cae en QUEUE_SECRET y
# luego en SUPABASE_SERVICE_ROLE_KEY (comportamiento histórico), lo que ata las
# bajas a una credencial de BD. Ver docs/RELIABILITY.md §11.
# UNSUBSCRIBE_SECRET=            # openssl rand -hex 32
# UNSUBSCRIBE_SECRET_LEGACY=     # valor anterior, para no invalidar correos ya enviados

# Anti-bot (Cloudflare Turnstile). Las DOS o ninguna: solo el secreto del
# servidor haría que la cola rechace a todo el mundo con 403.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY= / TURNSTILE_SECRET_KEY=

# SEO (opcional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Error tracking (Sentry). El SDK ya está integrado: sin DSN queda inerte.
# SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Solo para subir source maps durante el build (opcional):
# SENTRY_AUTH_TOKEN= / SENTRY_ORG= / SENTRY_PROJECT=
