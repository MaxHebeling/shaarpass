# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...            # server-only, NUNCA al cliente

# ---------- Stripe (Connect) ----------
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...            # para onboarding de organizadores

# ---------- Plataforma (fees transparentes) ----------
# Diferenciador #1: fees bajos y transparentes. Estos valores se muestran al organizador.
PLATFORM_FEE_PERCENT=2.0                    # % sobre el subtotal
PLATFORM_FEE_FIXED_CENTS=50                 # cargo fijo por boleto, en centavos

# ---------- Email ----------
RESEND_API_KEY=re_...
EMAIL_FROM="Ticketera <no-reply@tudominio.com>"

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
